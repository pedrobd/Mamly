<?xml version="1.0" encoding="utf-8"?>
<!-- Widget do ecrã principal: «mamly» por cima e o botão do microfone da app. Tocas e o Mamly abre logo a ouvir. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="2dp"
    android:contentDescription="@string/widget_label">
    <ImageView
        android:layout_width="44dp"
        android:layout_height="15dp"
        android:layout_marginBottom="5dp"
        android:src="@drawable/widget_wordmark"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />
    <ImageView
        android:id="@+id/widget_btn"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/widget_bg"
        android:padding="19dp"
        android:src="@drawable/ic_widget_mic"
        android:contentDescription="@string/widget_label" />
</LinearLayout>
