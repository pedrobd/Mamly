<?xml version="1.0" encoding="utf-8"?>
<!-- Widget grande (2×2): cartão em degradê, «mamly», botão do microfone e «Toca e fala» -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:contentDescription="@string/widget_label">
    <ImageView
        android:layout_width="64dp"
        android:layout_height="22dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:src="@drawable/widget_wordmark"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <ImageView
            android:id="@+id/widget_btn"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/widget_btn_big"
            android:padding="25dp"
            android:src="@drawable/ic_widget_mic"
            android:contentDescription="@string/widget_label" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_tap"
            android:textColor="#E6FCFBF6"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
